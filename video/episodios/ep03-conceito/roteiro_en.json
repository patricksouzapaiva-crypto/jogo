   },
   "sem_legenda": true,
   "pausa_antes_s": 3.0
  },
  {
   "fala": "When Lucas got there the next morning, the apartment door was locked from the inside.",
   "cena": {
    "tipo": "texto",
    "texto": "When Lucas got there the next morning, the apartment door was locked from the inside.",
    "estilo": "maquina",
    "cps": 28
   },
   "sem_legenda": true,
   "pausa_antes_s": 2.4
  },
  {
   "fala": "And Rafael was gone.",
   "cena": {
