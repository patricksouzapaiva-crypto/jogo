    }
   ],
   "sem_legenda": true,
   "pausa_antes_s": 3.0
  },
  {
   "fala": "Good evening. Welcome back to The Last Shelter.",
   "cena": {
    "imagem": "../../painel/cenarios/abrigo_16x9.png",
    "vigia": true,
    "zoom": [
     1.0,
     1.04
    ],
    "foco": [
