    "texto": "VOICE MESSAGE · 3:40 AM\nLucas… it's me. Sorry, I know it's late.",
    "estilo": "maquina",
    "tamanho": 60,
    "cps": 34
   },
   "sem_legenda": true,
   "voz_fx": "telefone"
  },
  {
   "fala": "\"I found her. She's in every single photo.\"",
   "cena": {
